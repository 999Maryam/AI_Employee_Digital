# ============================================================================
# Social Media Automation System - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: Never commit .env to git (it's in .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# SYSTEM CONFIGURATION
# ----------------------------------------------------------------------------

# Dry-run mode (set to false to enable actual posting)
# When true: simulates posts without actually posting
# When false: posts will be published to platforms
DRY_RUN=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
# DEBUG: Verbose output for troubleshooting
# INFO: Standard operational logs (recommended)
# WARNING: Only warnings and errors
# ERROR: Only errors
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# ODOO CONFIGURATION (for invoice creation)
# ----------------------------------------------------------------------------

# Odoo instance URL (include https://)
ODOO_URL=https://your-instance.odoo.com

# Odoo database name
ODOO_DB=your_database_name

# Odoo user email
ODOO_USER=your_email@example.com

# Odoo password
ODOO_PASSWORD=your_odoo_password

# ----------------------------------------------------------------------------
# LINKEDIN CONFIGURATION (optional - uses browser session)
# ----------------------------------------------------------------------------
# LinkedIn uses persistent browser sessions via Playwright
# No API credentials needed - login once via session_manager.py
# Session stored in: ./session/linkedin/

# ----------------------------------------------------------------------------
# FACEBOOK CONFIGURATION (optional - uses browser session)
# ----------------------------------------------------------------------------
# Facebook uses persistent browser sessions via Playwright
# No API credentials needed - login once via session_manager.py
# Session stored in: ./session/facebook/

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION (optional - for future email automation)
# ----------------------------------------------------------------------------

# SMTP server configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# For Gmail: Use App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords

# ----------------------------------------------------------------------------
# RATE LIMITING & ANTI-DETECTION
# ----------------------------------------------------------------------------

# Minimum delay between posts (seconds)
# Default: 60 seconds (recommended for anti-detection)
# RATE_LIMIT_DELAY=60

# Random delay range for actions (seconds)
# MIN_DELAY=2
# MAX_DELAY=4

# Typing speed delay (milliseconds per character)
# MIN_TYPING_DELAY=30
# MAX_TYPING_DELAY=80

# ----------------------------------------------------------------------------
# RETRY CONFIGURATION
# ----------------------------------------------------------------------------

# Maximum retry attempts for failed posts
# MAX_RETRIES=3

# Cooldown between retries (seconds)
# RETRY_COOLDOWN=300

# ----------------------------------------------------------------------------
# SESSION CONFIGURATION
# ----------------------------------------------------------------------------

# Browser headless mode (true/false)
# true: Browser runs in background (recommended for production)
# false: Browser window visible (useful for debugging)
# HEADLESS=true

# Session timeout (seconds)
# SESSION_TIMEOUT=3600

# ----------------------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------------------
# 1. LinkedIn and Facebook use browser automation (Playwright)
#    - No API keys needed
#    - Login once via: python social_media/session_manager.py --platform linkedin --setup
#    - Session persists in ./session/ folder
#
# 2. Odoo uses XML-RPC API
#    - Requires URL, database name, user, and password
#    - Test connection: python social_media/executor.py odoo "Test" --customer "Test" --amount 100
#
# 3. Always test with DRY_RUN=true first
#    - Verify posts look correct before going live
#    - Check logs in ./Logs/ folder
#
# 4. Security best practices:
#    - Never commit .env to git
#    - Use strong passwords
#    - Enable 2FA on social media accounts
#    - Rotate credentials regularly
#
# ============================================================================
